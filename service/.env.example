PORT=8080
DATABASE_FILE=./db/laundry.sqlite
NODE_ENV=development

# P4 tahap 3: nilai dari discovery document authorization server dan identifier
# API. Bukan credential. Isi ketiganya sebelum menjalankan service; service
# gagal start (exit non-zero) bila salah satu kosong.
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_AUDIENCE=

# P5: origin browser yang boleh membaca respons service ini. Daftar dipisah
# koma, harus origin lengkap (scheme://host[:port]) tanpa path dan tanpa
# wildcard. Kosong berarti tidak ada origin browser yang diizinkan.
#
#   Development  : http://localhost:3000
#   Production   : origin web app yang sudah di-deploy
CORS_ALLOWED_ORIGINS=http://localhost:3000
