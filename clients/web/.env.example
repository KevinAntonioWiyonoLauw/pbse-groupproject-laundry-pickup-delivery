# Konfigurasi web client (Next.js).
#
# SEMUA nilai di bawah ini ikut ter-bundle ke JavaScript yang dikirim ke
# browser, jadi tidak boleh ada rahasia di sini. Aplikasi ini adalah public
# client OIDC dan memakai Authorization Code + PKCE, sehingga tidak punya
# client secret. Jangan pernah menambahkan client secret ke file ini.
#
# Salin file ini menjadi `.env.local` untuk pengembangan lokal:
#   cp clients/web/.env.example clients/web/.env.local
#
# Di Vercel, isi nilainya di Project Settings -> Environment Variables.
# Vercel hanya mengekspos variabel berawalan NEXT_PUBLIC_ ke browser.

# ---------------------------------------------------------------------------
# API service (kontrak 1.3.0)
# ---------------------------------------------------------------------------
# HARUS berakhir dengan /v1: operasi di openapi.yaml berada di bawah prefix itu
# (mis. GET /v1/orders). Tanpa /v1, setiap request akan dijawab 404.
# Produksi:
NEXT_PUBLIC_API_BASE_URL=https://pbse.kevinio.my.id/v1
# Lokal:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1

# ---------------------------------------------------------------------------
# Authorization server (Keycloak)
# ---------------------------------------------------------------------------
# Nilai produksi harus sama persis dengan OIDC_ISSUER di service/.env, karena
# claim `iss` token diverifikasi terhadap nilai itu (jose, di service).
# Produksi (Keycloak hosted di Railway):
NEXT_PUBLIC_OIDC_ISSUER=https://keycloak-production-68f0.up.railway.app/realms/laundry
# Lokal (docker-compose.auth.yml):
# NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8081/realms/laundry

# Public client untuk aplikasi web. Tidak ada secret (lihat header file).
NEXT_PUBLIC_OIDC_CLIENT_ID=laundry-web

# Harus terdaftar persis di `redirectUris` client `laundry-web` pada realm.
# Origin lokal yang sudah terdaftar: http://localhost:3000 dan
# http://localhost:5173. Tambahkan origin Vercel lewat import.mjs:
#   WEB_REDIRECT_URIS="https://<project>.vercel.app/callback" \
#   WEB_ORIGINS="https://<project>.vercel.app" \
#   node auth/keycloak/import.mjs <keycloak-host>
# Di Vercel: https://<project>.vercel.app/callback
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/callback

# Dikirim sebagai parameter `audience` pada authorize/refresh, dan harus sama
# dengan OIDC_AUDIENCE di service/.env. Access token membawa `aud` ini lewat
# client scope `laundry-audience` (audience mapper).
NEXT_PUBLIC_OIDC_AUDIENCE=laundry-api

# Scope yang diminta saat login. `offline_access` membuat provider mengirim
# refresh token, sehingga sesi bertahan lebih lama dari access token (300 detik).
#
# Daftar ini HARUS persis sama dengan `optionalClientScopes` client
# `laundry-web` pada realm. Meminta scope yang tidak ditawarkan client membuat
# Keycloak menolak seluruh permintaan, bukan mengabaikannya:
#   "Invalid scopes: openid offline_access orders:read orders:write
#                    orders:fulfil pickups:read pickups:write"
# Client web sengaja TIDAK menawarkan `pickups:write`, karena operasi itu milik
# driver, bukan staff atau customer.
#
# Grant tetap dibatasi role user (`fullScopeAllowed: false`): staff tidak pernah
# menerima `orders:write` dan customer tidak pernah menerima `orders:fulfil`,
# meskipun keduanya boleh meminta scope itu di sini.
NEXT_PUBLIC_OIDC_SCOPE=openid offline_access orders:read orders:write orders:fulfil pickups:read
